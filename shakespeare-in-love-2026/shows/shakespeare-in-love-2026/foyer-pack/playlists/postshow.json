{
  "schema_version": 1,
  "phase": "postshow",
  "policy": {
    "min_dwell_seconds": 9,
    "max_dwell_seconds": 24,
    "max_words_per_screen": 60,
    "consecutive_repeat": false,
    "loop_target_seconds": 300,
    "audio_allowed": false,
    "group_rotation": [
      "making",
      "conversation",
      "theatre"
    ]
  },
  "items": [
    {
      "kind": "one-shot",
      "id": "thank-you",
      "template": "thank-you",
      "trigger": "start",
      "dwell_seconds": 15
    },
    {
      "kind": "anchor",
      "id": "next-production-appropriate",
      "template": "next-production-postshow",
      "every_n": 5,
      "production_ref": "next_productions.json#appropriate-2027",
      "dwell_seconds": 13,
      "_note": "R14 postshow anchor."
    },
    {
      "kind": "wildcard",
      "id": "set-build",
      "template": "story-montage",
      "tag": "making",
      "weight": 2,
      "dwell_seconds": 21,
      "review_status": "draft",
      "draft_owner": "the set-build team",
      "draft_label": "photographs to come from the set-build team",
      "content": {
        "eyebrow": "Behind the scenes",
        "headline": "Building the set",
        "body": "Photographs from the set-building team to come.",
        "frames": [
          {
            "source": "assets/placeholders/set-build-1.svg",
            "caption": "To come",
            "alt": "Placeholder for a set-building photograph"
          },
          {
            "source": "assets/placeholders/set-build-2.svg",
            "caption": "To come",
            "alt": "Placeholder for a set-building photograph"
          },
          {
            "source": "assets/placeholders/set-build-3.svg",
            "caption": "Finished",
            "alt": "Placeholder for a photograph of the finished set"
          }
        ],
        "footline": "Set built by the Criterion set-building team"
      },
      "_note": "R7 slot, one card for now; grows to a 4-6 card sequence when the team's photographs arrive (count, credits owed)."
    },
    {
      "kind": "wildcard",
      "id": "prop-clip-1-postshow",
      "template": "feature",
      "tag": "making",
      "weight": 1,
      "dwell_seconds": 14,
      "source": "assets/placeholders/prop-clip.svg",
      "content": {
        "eyebrow": "Made on stage",
        "headline": "Props made in front of you",
        "body": "The cast make some of tonight's props on stage.",
        "footline": "Clip to come from the company"
      },
      "review_status": "draft",
      "draft_owner": "the company",
      "draft_label": "clip to come from the company",
      "_note": "R9 placeholder. When clips arrive: item.video (videos/*.webm, landscape, 4-5 s, under 3 MB) + item.poster; one card per clip."
    },
    {
      "kind": "wildcard",
      "id": "hist-no-women-postshow",
      "template": "did-you-know",
      "tag": "conversation",
      "weight": 1,
      "dwell_seconds": 15,
      "content": {
        "eyebrow": "Did you know",
        "headline": "No women on the stage",
        "body": "In Shakespeare's lifetime every female role, Juliet included, was played by a boy. Women first acted on England's public stage in the 1660s.",
        "image_local": "assets/posters/shakespeare-in-love-2026.jpg"
      }
    },
    {
      "kind": "wildcard",
      "id": "hist-the-rose-postshow",
      "template": "did-you-know",
      "tag": "conversation",
      "weight": 1,
      "dwell_seconds": 15,
      "content": {
        "eyebrow": "Did you know",
        "headline": "The Rose",
        "body": "Henslowe's Rose, built in 1587, was Bankside's first playhouse. Its foundations were rediscovered in 1989.",
        "image_local": "assets/posters/shakespeare-in-love-2026.jpg"
      }
    },
    {
      "kind": "wildcard",
      "id": "hist-plague-postshow",
      "template": "did-you-know",
      "tag": "conversation",
      "weight": 1,
      "dwell_seconds": 15,
      "content": {
        "eyebrow": "Did you know",
        "headline": "Closed by plague",
        "body": "In 1592 and 1593 plague kept London's playhouses shut for months on end.",
        "image_local": "assets/posters/shakespeare-in-love-2026.jpg"
      }
    },
    {
      "kind": "wildcard",
      "id": "hist-penny-postshow",
      "template": "did-you-know",
      "tag": "conversation",
      "weight": 1,
      "dwell_seconds": 15,
      "content": {
        "eyebrow": "Did you know",
        "headline": "A penny to stand",
        "body": "A penny bought standing room in the open yard, among the groundlings.",
        "image_local": "assets/posters/shakespeare-in-love-2026.jpg"
      }
    },
    {
      "kind": "wildcard",
      "id": "hist-old-story-postshow",
      "template": "did-you-know",
      "tag": "conversation",
      "weight": 1,
      "dwell_seconds": 15,
      "content": {
        "eyebrow": "Did you know",
        "headline": "An old story",
        "body": "Romeo and Juliet was already an old tale. Shakespeare took it from Arthur Brooke's poem of 1562.",
        "image_local": "assets/posters/shakespeare-in-love-2026.jpg"
      }
    },
    {
      "kind": "wildcard",
      "id": "hist-revels-postshow",
      "template": "did-you-know",
      "tag": "conversation",
      "weight": 1,
      "dwell_seconds": 15,
      "content": {
        "eyebrow": "Did you know",
        "headline": "The Master of the Revels",
        "body": "Every play needed his licence, and he could cut it or ban it.",
        "image_local": "assets/posters/shakespeare-in-love-2026.jpg"
      }
    },
    {
      "kind": "wildcard",
      "id": "bar-stays-open",
      "template": "bar-stays-open",
      "sales_intent": true,
      "tag": "theatre",
      "weight": 2,
      "dwell_seconds": 12,
      "content": {
